# =============================================================================
# Conversational Commerce & Checkout Agent: Environment Configuration
# -----------------------------------------------------------------------------
# Single source of configuration for ALL services and infrastructure.
#   * Copy to `.env` and fill in values. `.env` is git-ignored; never commit it.
#   * Docker Compose reads this file and passes each service ONLY the variables
#     it needs (explicit `environment:` lists in docker-compose.yml), so a
#     secret is visible only to the service that uses it.
#   * `${VAR}` references are resolved by Docker Compose.
#   * Every service validates its variables at startup (pydantic-settings) and
#     refuses to start on invalid configuration.
#   * Money amounts are in MINOR units (e.g. cents) of DEFAULT_CURRENCY.
# =============================================================================

# ----------------------------------------------------------------------------
# [shared] Platform
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=commerce-agent
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console
DEFAULT_MERCHANT_ID=merchant_demo
PUBLIC_BASE_URL=http://localhost:8088    # public URL served by Traefik (Stripe success/cancel, widget)

# ----------------------------------------------------------------------------
# [infra] Docker image versions (pulled). Bump deliberately.
# ----------------------------------------------------------------------------
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18
REDIS_IMAGE=redis:8.8-alpine
RABBITMQ_IMAGE=rabbitmq:4.3-management-alpine
TRAEFIK_IMAGE=traefik:v3.7
STRIPE_CLI_IMAGE=stripe/stripe-cli:v1.51.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.161.0
JAEGER_IMAGE=jaegertracing/jaeger:2.21.0
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
GRAFANA_IMAGE=grafana/grafana:13.2.2
# Base images for our own service builds
PYTHON_BASE_IMAGE=python:3.13-slim
NODE_BASE_IMAGE=node:24-alpine
NGINX_BASE_IMAGE=nginx:1.30-alpine
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.18   # build stage only; never in runtime images

# ----------------------------------------------------------------------------
# [infra] Host port mappings (dev only; in prod only Traefik is exposed)
# ----------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=8088
TRAEFIK_DASHBOARD_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# ----------------------------------------------------------------------------
# [infra] PostgreSQL: one instance in dev, one database + role per service
# ----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
COMMERCE_DB_NAME=commerce
COMMERCE_DB_USER=commerce_svc
COMMERCE_DB_PASSWORD=change-me-commerce
CHECKOUT_DB_NAME=checkout
CHECKOUT_DB_USER=checkout_svc
CHECKOUT_DB_PASSWORD=change-me-checkout
FULFILLMENT_DB_NAME=fulfillment
FULFILLMENT_DB_USER=fulfillment_svc
FULFILLMENT_DB_PASSWORD=change-me-fulfillment
AGENT_DB_NAME=agent
AGENT_DB_USER=agent_svc
AGENT_DB_PASSWORD=change-me-agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ----------------------------------------------------------------------------
# [infra] Redis (logical DB index per service)
# ----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
GATEWAY_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
AGENT_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
COMMERCE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/2
CHECKOUT_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/3    # scheduler leader lock only

# ----------------------------------------------------------------------------
# [infra] RabbitMQ
# ----------------------------------------------------------------------------
RABBITMQ_USER=commerce
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_VHOST=commerce
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/${RABBITMQ_VHOST}
EVENTS_EXCHANGE=commerce.events
EVENTS_DLX=commerce.events.dlx
EVENT_MAX_DELIVERY_ATTEMPTS=8
EVENT_RETRY_DELAYS_SECONDS=5,30,120,600   # delayed-retry ladder before DLQ
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
WORKER_HEALTH_PORT=8001              # workers expose GET /health on this port

# ----------------------------------------------------------------------------
# [shared] Internal service URLs & service-to-service auth
# Each CALLER holds its own plaintext key; each CALLEE holds only the SHA-256
# hash of the keys it accepts (so no service can impersonate another).
# Generate a key + hash pair:
#   python -c "import secrets,hashlib; k=secrets.token_urlsafe(32); print(k); print(hashlib.sha256(k.encode()).hexdigest())"
# ----------------------------------------------------------------------------
AGENT_SERVICE_URL=http://agent-api:8000
COMMERCE_SERVICE_URL=http://commerce-api:8000
CHECKOUT_SERVICE_URL=http://checkout-api:8000
GATEWAY_SVC_API_KEY=change-me-gateway-key          # held by gateway   | scopes: agent:turns, checkout:confirmations:issue, checkout:confirm
GATEWAY_SVC_API_KEY_HASH=change-me-sha256-hex      # held by agent, checkout
AGENT_SVC_API_KEY=change-me-agent-key              # held by agent     | scopes: commerce:read, commerce:cart:write, checkout:orders:read
AGENT_SVC_API_KEY_HASH=change-me-sha256-hex        # held by commerce, checkout
CHECKOUT_SVC_API_KEY=change-me-checkout-key        # held by checkout  | scopes: commerce:read, commerce:quotes:lock
CHECKOUT_SVC_API_KEY_HASH=change-me-sha256-hex     # held by commerce
INTERNAL_HTTP_TIMEOUT_SECONDS=5
INTERNAL_HTTP_MAX_RETRIES=2                   # idempotent calls only

# ----------------------------------------------------------------------------
# [shared] Observability
# ----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
METRICS_ENABLED=true
ALERT_WEBHOOK_URL=                  # Slack/Teams/PagerDuty webhook for critical alerts
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ============================================================================
# [gateway-svc] Channels, sessions, confirmation click-through
# ============================================================================
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_SESSION_TTL_MINUTES=60
WIDGET_PUBLISHABLE_KEY=pk_widget_demo_123
MERCHANT_NAME=Northwind Outfitters
MERCHANT_LOGO_URL=
WIDGET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_TTL_MINUTES=1440
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_CHECKOUTS_PER_HOUR=5
RATE_LIMIT_IP_REQUESTS_PER_MINUTE=120
IDEMPOTENCY_TTL_HOURS=24
# Telegram
TELEGRAM_ENABLED=false              # true requires TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=                 # from @BotFather
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_UPDATE_MODE=polling        # webhook | polling (polling for local dev without a public URL)
TELEGRAM_WEBHOOK_URL=               # public HTTPS URL, e.g. https://<tunnel>/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=            # echoed as X-Telegram-Bot-Api-Secret-Token (1-256 chars, A-Z a-z 0-9 _ -)
TELEGRAM_ALLOWED_UPDATES=message,callback_query

# ============================================================================
# [widget] Chat widget (Vite reads only VITE_* vars, from this same file)
# ============================================================================
VITE_GATEWAY_BASE_URL=${PUBLIC_BASE_URL}              # default gateway URL baked into the bundle
VITE_WIDGET_PUBLISHABLE_KEY=${WIDGET_PUBLISHABLE_KEY} # dev playground only
VITE_USE_MOCKS=true                                   # dev playground: serve the gateway API from Mock Service Worker

# ============================================================================
# [agent-svc] LLM (Groq), LangGraph, guardrails
# ============================================================================
AGENT_DATABASE_URL=postgresql://${AGENT_DB_USER}:${AGENT_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${AGENT_DB_NAME}
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com  # ChatGroq/groq SDK base (SDK appends /openai/v1)
# Models must exist for YOUR key: GET https://api.groq.com/openai/v1/models
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b  # tool calling; reasoning_effort=low
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b  # different family + separate rate-limit bucket
GROQ_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m  # prompt-injection classifier (score 0..1)
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=512
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=1  # fallback only; primary fails over immediately (e.g. 429)
LANGGRAPH_CHECKPOINTER=postgres     # postgres | memory (memory = tests only)
AGENT_RECURSION_LIMIT=25            # LangGraph step cap per turn (≈4 tool rounds + guards); ≥12
AGENT_TURN_TIMEOUT_SECONDS=45
AGENT_HISTORY_MAX_MESSAGES=16
AGENT_PROMPT_VERSION=v1
GUARDRAIL_INPUT_CLASSIFIER_ENABLED=true
GUARDRAIL_OUTPUT_AMOUNT_VALIDATION_ENABLED=true
GUARDRAIL_MAX_REGENERATIONS=1
GUARDRAIL_INJECTION_THRESHOLD=0.5
TRANSCRIPT_RETENTION_DAYS=30
LANGSMITH_TRACING=false             # optional agent tracing / evals
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=commerce-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================================
# [commerce-svc] Catalog, pricing, FX, promotions, tax, quotes, inventory
# ============================================================================
COMMERCE_DATABASE_URL=postgresql+asyncpg://${COMMERCE_DB_USER}:${COMMERCE_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${COMMERCE_DB_NAME}
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,NGN,JPY
PRICING_FX_FALLBACK_ENABLED=true    # convert from base price when no explicit price-book entry
FX_PROVIDER=static                  # static | openexchangerates
FX_API_URL=
FX_API_KEY=
FX_RATE_TTL_MINUTES=60
FX_MAX_RATE_AGE_MINUTES=240         # refuse quotes built on staler rates
TAX_PROVIDER=static                 # static | stripe_tax
TAX_DEFAULT_BEHAVIOR=exclusive      # exclusive | inclusive (region rules may override)
MERCHANT_ORIGIN_COUNTRY=US
STRIPE_TAX_API_KEY=                 # restricted key (Tax calculations only) when TAX_PROVIDER=stripe_tax
QUOTE_TTL_MINUTES=15
INVENTORY_RESERVATION_TTL_MINUTES=35
MAX_ITEM_QUANTITY=20
# 32-byte urlsafe base64 Fernet key for column-level PII encryption (addresses).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ============================================================================
# [checkout-svc] Confirmations, orders, Stripe, refunds, audit, reconciliation
# ============================================================================
CHECKOUT_DATABASE_URL=postgresql+asyncpg://${CHECKOUT_DB_USER}:${CHECKOUT_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${CHECKOUT_DB_NAME}
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_  # dev: docker compose --profile dev-tools run --rm stripe-cli listen --print-secret
STRIPE_API_VERSION=2026-08-26.dahlia
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_MAX_NETWORK_RETRIES=2
CHECKOUT_MODE=checkout_session      # checkout_session | payment_intent
CHECKOUT_SUCCESS_PATH=/checkout/success
CHECKOUT_CANCEL_PATH=/checkout/cancel
CHECKOUT_SESSION_EXPIRY_MINUTES=30  # Stripe minimum is 30
CONFIRMATION_TOKEN_TTL_MINUTES=10
ORDER_CREATED_STALE_SECONDS=120     # sweeper resumes/cancels orders stuck in CREATED
MAX_ORDER_TOTAL_MINOR=500000        # hard per-order ceiling (e.g. $5,000.00)
COMPENSATION_AUTO_REFUND_ENABLED=true
RECONCILIATION_ENABLED=true
RECONCILIATION_CRON=0 * * * *
RECONCILIATION_LOOKBACK_HOURS=48

# ============================================================================
# [fulfillment-svc] Provider adapter
# ============================================================================
FULFILLMENT_DATABASE_URL=postgresql+asyncpg://${FULFILLMENT_DB_USER}:${FULFILLMENT_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${FULFILLMENT_DB_NAME}
FULFILLMENT_PROVIDER=mock           # mock (a real 3PL http adapter plugs in behind the same interface)
FULFILLMENT_API_URL=
FULFILLMENT_API_KEY=
FULFILLMENT_TIMEOUT_SECONDS=15
FULFILLMENT_MAX_RETRIES=5
FULFILLMENT_MOCK_FAILURE_RATE=0.0   # >0 to exercise the compensation saga in dev
FULFILLMENT_MOCK_LATENCY_MS=800     # simulated warehouse response time
FULFILLMENT_MOCK_FAIL_SKUS=         # comma-separated SKUs the mock warehouse refuses (demo failures)
