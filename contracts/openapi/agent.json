{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "TurnContext": {
        "properties": {
          "channel": {
            "default": "web",
            "enum": [
              "web",
              "telegram"
            ],
            "title": "Channel",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "locale": {
            "default": "en-US",
            "maxLength": 35,
            "title": "Locale",
            "type": "string"
          },
          "merchant_name": {
            "default": "our store",
            "maxLength": 120,
            "title": "Merchant Name",
            "type": "string"
          }
        },
        "required": [
          "currency"
        ],
        "title": "TurnContext",
        "type": "object"
      },
      "TurnRequest": {
        "properties": {
          "action": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "client_message_id": {
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_\\-:.]+$",
            "title": "Client Message Id",
            "type": "string"
          },
          "context": {
            "$ref": "#/components/schemas/TurnContext"
          },
          "text": {
            "maxLength": 1000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "client_message_id",
          "text",
          "context"
        ],
        "title": "TurnRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "agent-svc",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/conversations/{conversation_id}/messages": {
      "get": {
        "operationId": "get_messages_v1_conversations__conversation_id__messages_get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_\\-:]{1,64}$",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Messages V1 Conversations  Conversation Id  Messages Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Messages",
        "tags": [
          "conversations"
        ]
      }
    },
    "/v1/conversations/{conversation_id}/turns": {
      "post": {
        "description": "Streams one turn as SSE.\n\nEvents: turn.started → text.delta* → block* → suggestions? → turn.completed | turn.error.",
        "operationId": "run_turn_v1_conversations__conversation_id__turns_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_\\-:]{1,64}$",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Turn",
        "tags": [
          "conversations"
        ]
      }
    }
  }
}
