{
  "components": {
    "schemas": {
      "ConfirmBody": {
        "properties": {
          "confirmation_token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Confirmation Token",
            "type": "string"
          }
        },
        "required": [
          "confirmation_token"
        ],
        "title": "ConfirmBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "locale": {
            "default": "en-US",
            "maxLength": 35,
            "title": "Locale",
            "type": "string"
          },
          "publishable_key": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Publishable Key",
            "type": "string"
          },
          "resume_conversation_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Conversation Id"
          }
        },
        "required": [
          "publishable_key"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "TurnBody": {
        "properties": {
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "client_message_id": {
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_\\-:.]+$",
            "title": "Client Message Id",
            "type": "string"
          },
          "text": {
            "maxLength": 1000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "client_message_id",
          "text"
        ],
        "title": "TurnBody",
        "type": "object"
      },
      "UserAction": {
        "description": "Structured UI actions the widget may send. Anything else is rejected at the edge.",
        "properties": {
          "cart_item_id": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cart Item Id"
          },
          "product_id": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "quantity": {
            "anyOf": [
              {
                "maximum": 999.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "sku_id": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku Id"
          },
          "type": {
            "enum": [
              "add_to_cart",
              "update_cart_item",
              "remove_cart_item",
              "view_product",
              "start_checkout",
              "refresh_quote"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "UserAction",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "gateway-svc",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/checkout/confirm": {
      "post": {
        "description": "The customer's explicit \"Confirm & pay\" click. Goes straight to checkout-svc, never via the agent.",
        "operationId": "confirm_checkout_v1_checkout_confirm_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Confirm Checkout V1 Checkout Confirm Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Checkout",
        "tags": [
          "widget"
        ]
      }
    },
    "/v1/conversations/{conversation_id}/events": {
      "get": {
        "description": "Server push (order updates, compensation notices). Order events arrive with M4 (RabbitMQ);\nuntil then this holds the connection open with heartbeats so the widget shows 'connected'.",
        "operationId": "conversation_events_v1_conversations__conversation_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_\\-]{1,64}$",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Conversation Events",
        "tags": [
          "widget"
        ]
      }
    },
    "/v1/conversations/{conversation_id}/messages": {
      "get": {
        "operationId": "conversation_history_v1_conversations__conversation_id__messages_get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_\\-]{1,64}$",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Conversation History V1 Conversations  Conversation Id  Messages Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Conversation History",
        "tags": [
          "widget"
        ]
      }
    },
    "/v1/conversations/{conversation_id}/turns": {
      "post": {
        "operationId": "run_turn_v1_conversations__conversation_id__turns_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_\\-]{1,64}$",
              "title": "Conversation Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Turn",
        "tags": [
          "widget"
        ]
      }
    },
    "/v1/orders/{order_id}": {
      "get": {
        "operationId": "get_order_v1_orders__order_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Order V1 Orders  Order Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Order",
        "tags": [
          "widget"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "create_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Session V1 Sessions Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "widget"
        ]
      }
    }
  }
}
