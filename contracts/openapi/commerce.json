{
  "components": {
    "schemas": {
      "AddItemRequest": {
        "properties": {
          "quantity": {
            "default": 1,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          },
          "sku_id": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Sku Id",
            "type": "string"
          }
        },
        "required": [
          "sku_id"
        ],
        "title": "AddItemRequest",
        "type": "object"
      },
      "AdvertisedPromotionDTO": {
        "properties": {
          "amount_off": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "min_subtotal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "percent_off": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent Off"
          }
        },
        "required": [
          "code",
          "label",
          "description",
          "percent_off",
          "amount_off",
          "min_subtotal"
        ],
        "title": "AdvertisedPromotionDTO",
        "type": "object"
      },
      "ApplyPromoRequest": {
        "properties": {
          "code": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "ApplyPromoRequest",
        "type": "object"
      },
      "CartLineDTO": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "line_total": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "unit_price": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "variant_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant Label"
          }
        },
        "required": [
          "id",
          "sku_id",
          "product_id",
          "name",
          "variant_label",
          "image_url",
          "quantity",
          "unit_price",
          "line_total"
        ],
        "title": "CartLineDTO",
        "type": "object"
      },
      "CartSnapshotDTO": {
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "discount_total": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "discounts": {
            "items": {
              "$ref": "#/components/schemas/DiscountDTO"
            },
            "title": "Discounts",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "item_count": {
            "title": "Item Count",
            "type": "integer"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/CartLineDTO"
            },
            "title": "Lines",
            "type": "array"
          },
          "promo_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Promo Code"
          },
          "promo_issue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PromoIssueDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "shipping_destination": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DestinationDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "subtotal": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "total_after_discounts": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "currency",
          "version",
          "lines",
          "item_count",
          "subtotal",
          "discounts",
          "discount_total",
          "total_after_discounts",
          "promo_code",
          "promo_issue",
          "shipping_destination"
        ],
        "title": "CartSnapshotDTO",
        "type": "object"
      },
      "CreateCartRequest": {
        "properties": {
          "conversation_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Conversation Id",
            "type": "string"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          }
        },
        "required": [
          "conversation_id"
        ],
        "title": "CreateCartRequest",
        "type": "object"
      },
      "DestinationDTO": {
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          }
        },
        "required": [
          "country",
          "region"
        ],
        "title": "DestinationDTO",
        "type": "object"
      },
      "DiscountDTO": {
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "code",
          "label",
          "amount"
        ],
        "title": "DiscountDTO",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LockRequest": {
        "properties": {
          "order_id": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Order Id",
            "type": "string"
          }
        },
        "required": [
          "order_id"
        ],
        "title": "LockRequest",
        "type": "object"
      },
      "MoneyDTO": {
        "description": "Wire format shared by every API and the widget: ``{amount_minor, currency}``.",
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "title": "MoneyDTO",
        "type": "object"
      },
      "ProductSearchResponse": {
        "properties": {
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductSummaryDTO"
            },
            "title": "Products",
            "type": "array"
          }
        },
        "required": [
          "products"
        ],
        "title": "ProductSearchResponse",
        "type": "object"
      },
      "ProductSummaryDTO": {
        "properties": {
          "compare_at_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "in_stock": {
            "title": "In Stock",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "variant_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant Label"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/VariantDTO"
            },
            "title": "Variants",
            "type": "array"
          }
        },
        "required": [
          "id",
          "sku_id",
          "name",
          "variant_label",
          "description",
          "image_url",
          "price",
          "compare_at_price",
          "in_stock",
          "rating",
          "variants"
        ],
        "title": "ProductSummaryDTO",
        "type": "object"
      },
      "PromoIssueDTO": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "code",
          "reason",
          "message"
        ],
        "title": "PromoIssueDTO",
        "type": "object"
      },
      "PromotionListResponse": {
        "properties": {
          "promotions": {
            "items": {
              "$ref": "#/components/schemas/AdvertisedPromotionDTO"
            },
            "title": "Promotions",
            "type": "array"
          }
        },
        "required": [
          "promotions"
        ],
        "title": "PromotionListResponse",
        "type": "object"
      },
      "QuoteDTO": {
        "properties": {
          "cart_id": {
            "title": "Cart Id",
            "type": "string"
          },
          "cart_version": {
            "title": "Cart Version",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "discounts": {
            "items": {
              "$ref": "#/components/schemas/DiscountDTO"
            },
            "title": "Discounts",
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fx_rate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fx Rate Id"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "invalid_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invalid Reason"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/QuoteLineDTO"
            },
            "title": "Lines",
            "type": "array"
          },
          "shipping": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "subtotal": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "tax_inclusive": {
            "title": "Tax Inclusive",
            "type": "boolean"
          },
          "tax_total": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "total": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "cart_id",
          "cart_version",
          "status",
          "valid",
          "invalid_reason",
          "currency",
          "lines",
          "subtotal",
          "discounts",
          "shipping",
          "tax_total",
          "tax_inclusive",
          "total",
          "fx_rate_id",
          "hash",
          "expires_at"
        ],
        "title": "QuoteDTO",
        "type": "object"
      },
      "QuoteLineDTO": {
        "properties": {
          "discount": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "line_total": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "tax": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "unit_price": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "variant_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant Label"
          }
        },
        "required": [
          "sku_id",
          "name",
          "variant_label",
          "quantity",
          "unit_price",
          "line_total",
          "discount",
          "tax"
        ],
        "title": "QuoteLineDTO",
        "type": "object"
      },
      "ShippingAddressRequest": {
        "properties": {
          "city": {
            "maxLength": 120,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "country": {
            "description": "ISO 3166-1 alpha-2",
            "pattern": "^[A-Z]{2}$",
            "title": "Country",
            "type": "string"
          },
          "line1": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Line1",
            "type": "string"
          },
          "line2": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line2"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "postal_code": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Postal Code",
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "maxLength": 10,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "State/province code, e.g. TX",
            "title": "Region"
          }
        },
        "required": [
          "line1",
          "city",
          "postal_code",
          "country"
        ],
        "title": "ShippingAddressRequest",
        "type": "object"
      },
      "UpdateItemRequest": {
        "properties": {
          "quantity": {
            "description": "0 removes the line",
            "minimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "quantity"
        ],
        "title": "UpdateItemRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VariantDTO": {
        "properties": {
          "in_stock": {
            "title": "In Stock",
            "type": "boolean"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyDTO"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "variant_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant Label"
          }
        },
        "required": [
          "sku_id",
          "variant_label",
          "price",
          "in_stock"
        ],
        "title": "VariantDTO",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "commerce-svc",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/orders/{order_id}/commit": {
      "post": {
        "description": "Payment confirmed: stock leaves inventory, promotion use is final, cart emptied (idempotent).",
        "operationId": "commit_order_internal_orders__order_id__commit_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Commit Order Internal Orders  Order Id  Commit Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Commit Order",
        "tags": [
          "settlement"
        ]
      }
    },
    "/internal/orders/{order_id}/release": {
      "post": {
        "description": "Payment failed/expired: give stock and promotion uses back (idempotent).",
        "operationId": "release_order_internal_orders__order_id__release_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Release Order Internal Orders  Order Id  Release Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Release Order",
        "tags": [
          "settlement"
        ]
      }
    },
    "/internal/orders/{order_id}/void": {
      "post": {
        "description": "Paid order refunded (compensation): give promotion uses back; stock is not restocked (idempotent).",
        "operationId": "void_order_internal_orders__order_id__void_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Void Order Internal Orders  Order Id  Void Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Void Order",
        "tags": [
          "settlement"
        ]
      }
    },
    "/internal/quotes/{quote_id}/lock": {
      "post": {
        "description": "Confirm-time: lock the quote to one order and reserve its stock and promotion uses (idempotent).",
        "operationId": "lock_quote_internal_quotes__quote_id__lock_post",
        "parameters": [
          {
            "in": "path",
            "name": "quote_id",
            "required": true,
            "schema": {
              "title": "Quote Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lock Quote",
        "tags": [
          "settlement"
        ]
      }
    },
    "/v1/carts": {
      "post": {
        "description": "Naturally idempotent: one cart per conversation.",
        "operationId": "get_or_create_cart_v1_carts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCartRequest"
              }
            }
          },
          "required": true
        },
