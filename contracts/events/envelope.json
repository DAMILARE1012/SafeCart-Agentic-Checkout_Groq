{
  "description": "CloudEvents-style envelope carried as the AMQP body.",
  "properties": {
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "source",
    "time",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
